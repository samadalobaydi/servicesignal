# ──────────────────────────────────────────────────────────────
# ServiceSignal — environment variables
# Copy this file to .env.local and fill in your values.
# .env.local must sit in the project root, next to package.json.
# It is git-ignored and never committed.
# Restart the dev server after every change to this file.
# ──────────────────────────────────────────────────────────────

# ── Supabase ───────────────────────────────────────────────────
# From: supabase.com → your project → Settings → API

# 1. Project URL  (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 2a. Service role key  (recommended — bypasses RLS automatically)
#     Found under: Settings → API → Project API Keys → service_role
#     Keep this private. Never expose in client code or git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 2b. Anon / public key  (alternative to service role key)
#     Found under: Settings → API → Project API Keys → anon / public
#     Requires the RLS INSERT policy to be in place on beta_signups.
#     Only needed if you are NOT using SUPABASE_SERVICE_ROLE_KEY.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Future integrations ────────────────────────────────────────
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
