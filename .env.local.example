# ──────────────────────────────────────────────────────────────
# ServiceSignal — environment variables
# Copy this file to .env.local and fill in your values.
# .env.local must sit in the project root, next to package.json.
# It is git-ignored and never committed.
# Restart the dev server after every change to this file.
# ──────────────────────────────────────────────────────────────

# ── Supabase ───────────────────────────────────────────────────
# From: supabase.com → your project → Settings → API

# 1. Project URL  (required — used by both server and browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Anon / public key  (required — used by browser for Auth + invoice CRUD)
#    Found under: Settings → API → Legacy API Keys → anon/public
#    Safe to expose publicly — RLS policies enforce all security
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 3. Service role key  (required — used SERVER-SIDE ONLY for beta signup)
#    Found under: Settings → API → Legacy API Keys → service_role
#    NEVER expose this in client code. Keep it private.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── Application base URL (v8.9.2) ────────────────────────────────
# Used ONLY to build in-app links inside emails (e.g. the Welcome
# email's "Go to your dashboard" button) — NOT used for email images,
# which must always point at the real production domain regardless of
# environment (Gmail can never reach localhost).
#
# Local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (set this in Vercel's environment variables instead —
# do not put your real production URL in this local file):
# NEXT_PUBLIC_APP_URL=https://servicesignal.app
#
# If unset, falls back to https://servicesignal.app automatically —
# safe default for production, but means local testing needs this set
# explicitly or the Welcome email's dashboard link will point at
# production instead of your local session.

# ── Future integrations ────────────────────────────────────────
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Automated email reminders (Resend + Vercel Cron) ────────────
# Server-side only — never exposed to the browser.

# 1. Resend API key
#    From: resend.com → API Keys
#    Required to send reminder emails. If missing, reminders are
#    detected and queued as 'pending' but fail gracefully when sent.
RESEND_API_KEY=

# 2. Cron secret — any random string you generate yourself
#    REQUIRED. Vercel does NOT authenticate cron invocations by itself:
#    a cron endpoint is a normal public URL. What Vercel does is send the
#    value of THIS variable as `Authorization: Bearer <CRON_SECRET>` when it
#    invokes the job — but only if the variable is set on the project.
#
#    Both cron routes verify that header and FAIL CLOSED when the variable
#    is missing (401, no work done):
#      /api/cron/send-reminders        daily reminder detection
#      /api/cron/reconcile-reminders   send-outcome reconciliation
#
#    Generate with:
#      openssl rand -hex 32
CRON_SECRET=

# 3. Review-token signing secret (OPTIONAL)
#    Signs the server-minted authorisation that the reminder review page
#    issues and the approve route verifies. If unset, a key is derived from
#    SUPABASE_SERVICE_ROLE_KEY, so no deployment is left with a forgeable
#    token. Set it explicitly if you ever rotate the service-role key
#    independently of review sessions. Generate with:
#      openssl rand -hex 32
# REVIEW_TOKEN_SECRET=

# Note: REMINDER_MODE is NOT a global env var — each user controls
# their own approval/auto sending mode via profiles.reminder_mode
# in the dashboard Settings panel. Default is 'approval'.

# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL — REQUIRED IN EVERY ENVIRONMENT
# ─────────────────────────────────────────────────────────────────────────────
#
# Every account-journey link ServiceSignal generates server-side is built from
# this: the founding-beta verification link, the Welcome email CTA, the auth
# callback and the password-reset redirect.
#
# Rendering an email has no `window`, so there is NO self-detection fallback on
# the server. If this is unset or malformed, those links silently resolve to
# the hardcoded production origin — which is right in production and wrong
# everywhere else. A local tester then clicks a verification link and lands on
# the deployed production app instead of their own.
#
# PRODUCTION / VERCEL: set this in Project Settings -> Environment Variables
#   for Production   -> https://servicesignal.app
#   for Preview      -> the preview deployment URL, NOT the production origin.
#                       Vercel exposes NEXT_PUBLIC_VERCEL_URL; set this
#                       explicitly per-environment rather than relying on it.
#
# WATCH THE NEWLINE. This file is parsed line by line. A missing line break
# before this variable makes it part of the PREVIOUS value and leaves it
# undefined — which is exactly how local testing once ended up on production.
# lib/app-urls.ts now validates the value and logs loudly, but the check only
# fires if the variable exists at all.
